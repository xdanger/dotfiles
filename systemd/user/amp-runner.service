[Unit]
Description=Amp --no-tui runner
Documentation=https://ampcode.com/manual
# Start Herdr first, but keep the runner available if Herdr fails
Wants=herdr-server.service
After=herdr-server.service
ConditionFileIsExecutable=%h/.dotfiles/bin/amp-runner
ConditionFileIsExecutable=%h/.local/share/mise/shims/amp
# Retry forever; RestartSteps backs off so a persistent failure doesn't spin
StartLimitIntervalSec=0

[Service]
Type=simple
# Let threads served by this runner drive herdr panes over its socket
Environment=HERDR_ENV=1
Environment=HERDR_SOCKET_PATH=%h/.config/herdr/herdr.sock
# Wait up to 30s for DNS, so the first start after boot doesn't fail and retry.
# network-online.target can't do this: it doesn't exist in the user manager.
# The "-" prefix starts the runner anyway when the wait times out.
ExecStartPre=-/usr/bin/timeout 30 /bin/sh -c 'until getent ahosts ampcode.com >/dev/null 2>&1; do sleep 1; done'
ExecStart=%h/.dotfiles/bin/amp-runner
Restart=on-failure
# amp-runner exits 78 when none of its directories exist on this machine
RestartPreventExitStatus=78
RestartSec=5s
RestartSteps=6
RestartMaxDelaySec=5min
KillMode=control-group
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
